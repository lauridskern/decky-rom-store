  "type": "module",
  "description": "Renders the plugin UI outside the Steam client so it can be screenshotted and stress tested.",
  "scripts": {
    "build": "node build.mjs",
    "shots": "node build.mjs && node shoot.mjs",
    "soak": "node build.mjs && node soak.mjs",
    "aspects": "node build.mjs && node aspects.mjs",
